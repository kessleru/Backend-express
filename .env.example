# Copie este arquivo para .env e ajuste os valores.
#   cp .env.example .env
# O .env NÃO vai para o git. Este .env.example vai — ele documenta
# quais variáveis existem, sem expor valor nenhum.

# Porta HTTP do servidor
PORT=5050

# development | production | test
NODE_ENV=development

# --- A partir do módulo 09 (banco de dados) ---
# Caminho do arquivo SQLite
DATABASE_URL=file:./data/app.sqlite

# --- A partir do módulo 11 (autenticação) ---
# Segredo de assinatura do JWT. Em produção, gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-isto-em-producao

# --- A partir do módulo 15 (cache) ---
REDIS_URL=redis://localhost:6379
